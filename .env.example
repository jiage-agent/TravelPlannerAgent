# DeepSeek
DEEPSEEK_API_KEY=your_key_here
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
