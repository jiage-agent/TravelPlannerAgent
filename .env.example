# ==================== LLM ====================
# DeepSeek（默认 provider）
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼（可选，用于多模型切换）
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 默认使用的 provider：deepseek / dashscope
DEFAULT_PROVIDER=deepseek

# ==================== 外部工具 ====================
# 高德地图 Web 服务（天气 / 景点 POI / 驾车路线 / 地理编码）
# 申请地址：https://lbs.amap.com/ ，创建应用后选「Web 服务」类型 Key
AMAP_API_KEY=your_key_here

# Tavily 联网搜索（补充实时攻略、门票、交通信息；不填则自动跳过联网补充）
# 申请地址：https://tavily.com/
TAVILY_API_KEY=your_key_here

# ==================== 工具弹性配置 ====================
# 外部调用失败重试次数（1 次首发 + N 次重试）与退避基数（秒）
TOOL_RETRY_TIMES=3
TOOL_RETRY_BASE_DELAY=0.5

# 工具结果缓存 TTL（秒）
CACHE_TTL_GEOCODE=604800
CACHE_TTL_WEATHER=3600
CACHE_TTL_POI=86400
CACHE_TTL_ROUTE=86400
CACHE_TTL_SEARCH=21600

# ==================== 上下文预算 ====================
# 提示词各数据块共享的 token 上限，超出后按优先级截断
CONTEXT_MAX_TOKENS=6000
CONTEXT_KEEP_TURNS=6

# ==================== LLM 自主工具调用 ====================
ENABLE_LLM_TOOL_CALLING=true
LLM_TOOL_MAX_CALLS=2

# ==================== 鉴权 ====================
# 客户端调用接口时需在 Header 携带 X-API-Key
API_KEY=travel-planner-secret-2026

# ==================== 数据库 ====================
DB_PATH=./app/db/travel_agent.db

# ==================== 可观测性（可选）====================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=travel-planner-agent
